# Keys the API reads. Values live in Infisical (project `wishlist-api`,
# environments dev / staging / prod — ADR-0045); `npm start` injects them.
# A hand-written apps/api/.env with these keys still works offline.
PORT=3000
# Remote Turso: use libsql://<db>-<org>.turso.io; @libsql/client rejects turso://
DATABASE_URL=file:./local.db
# Turso token; required when DATABASE_URL is libsql:// or https://
# DATABASE_AUTH_TOKEN=
# Firebase project id: the ID token's aud, and the suffix of its iss
FIREBASE_PROJECT_ID=
LLM_API_KEY=
LLM_MODEL=
# Logging: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
LOG_PRETTY=true
# LOG_REQUEST_ID_HEADER=x-request-id
# Dev only: add the failure cause chain to error responses
HTTP_EXPOSE_FAILURES=true
# Optional extraction tunables (defaults shown)
# EXTRACTION_MARKDOWN_CAP=40000
# EXTRACTION_BUDGET_MS=3000
# EXTRACTION_FRESHNESS_MS=86400000
# EXTRACTION_FAILURE_WINDOW_MS=300000
